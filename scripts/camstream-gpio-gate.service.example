# GPIO (BCM17 → GND) → тот же режим, что Run and Debug «RPI: debug (webrtc)»:
#   config/webrtc.vps.env + webrtc --room pi-camera --ice-vps-only
#
# Не udp_h264 / send — только WebRTC через VPS (браузер http://116.203.148.254/cam).
#
# sudo cp scripts/camstream-gpio-gate.service.example /etc/systemd/system/camstream.service
# sudo nano /etc/systemd/system/camstream.service   # User, пути
# chmod +x scripts/camstream-gpio-wifi-fallback.sh scripts/camstream_webrtc.sh
# Если раньше был webrtc-vps.service — отключите, иначе два stream_camera дерутся за камеру:
#   sudo systemctl disable --now webrtc-vps.service
# sudo systemctl daemon-reload && sudo systemctl enable --now camstream.service
#
# Лог: sudo journalctl -u camstream.service -f
# Отладка с Attach: scripts/camstream-gpio-gate-debug.service.example (отдельный юнит)

[Unit]
Description=WebRTC via VPS (GPIO17 grounded = run, same as debug webrtc)
After=multi-user.target network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=pavel
Group=pavel
WorkingDirectory=/home/pavel/projects/Mobile_Raspberry_5-
SupplementaryGroups=gpio
Environment=CAMSTREAM_BOOT_GPIO_BCM=17
Environment=BOOT_GPIO_STABLE_MS=400
Environment=BOOT_GPIO_WAIT_GROUND_SEC=60
# Если GPIO не замкнут — поднять домашний Wi‑Fi (имя из nmcli connection show):
# Environment=CAMSTREAM_HOME_WIFI_CONN=MyHomeWiFi
# Без -v: DEBUG-логи RTP грузят CPU и рвут WebRTC (Consent expired).
ExecStart=/home/pavel/projects/Mobile_Raspberry_5-/scripts/camstream-gpio-wifi-fallback.sh --wrapper /home/pavel/projects/Mobile_Raspberry_5-/scripts/camstream_webrtc.sh --
Restart=no

[Install]
WantedBy=multi-user.target

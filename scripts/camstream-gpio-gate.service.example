# systemd: стрим только если выбранный GPIO (BCM) при старте замкнут на GND.
# Режим входа pull-up gpiozero: в покое высокий, к GND = низкий = запуск.
#
# Отладчик при включении Pi (GPIO17 → GND, ждёт Attach в Cursor — см. debugpy):
#   scripts/camstream-gpio-gate-debug.service.example
#
# sudo cp scripts/camstream-gpio-gate.service.example /etc/systemd/system/camstream.service
# sudo nano /etc/systemd/system/camstream.service   # User, BCM, рабочий каталог, путь к python
# sudo systemctl daemon-reload
# sudo systemctl enable camstream.service
# sudo systemctl start camstream.service
#
# Проверка: sudo journalctl -u camstream.service -b --no-pager
# Отдельный лог gate/debug (до запуска stream_camera): см. ~/.local/share/camstream/camstream_boot.log
#   или: Environment=CAMSTREAM_BOOT_LOG=/home/pavel/.../logs/camstream_boot.log
#
# Hotspot (точка доступа) поднимается только когда реально стартует stream_camera с --ap-ssid …
# Если GPIO не дал запуск приложения — подключение к дому (сохранённый профиль NM):
#   chmod +x scripts/camstream-gpio-wifi-fallback.sh
#   Environment=CAMSTREAM_HOME_WIFI_CONN=ИмяКакВ_nmcli_connection
#   ExecStart=.../camstream-gpio-wifi-fallback.sh send --video-mode udp_h264 --ap-ssid 12345 --ap-force --host 10.42.0.194 --port 5000 --stream-preset realtime
# Имя профиля: nmcli -t -f NAME connection show
# Отключите autoconnect у отдельного профиля «hotspot», если он мешал домашнему Wi‑Fi при загрузке.
#
# Если «не запускается» при замыкании на землю:
#   - Убедитесь, что пин указан BCM (pinout.xyz), общий GND с Pi.
#   - sudo usermod -aG gpio ваш_пользователь && перелогин (или supplementary group ниже).
#   - gate читает GPIO через системный Python3 (apt: python3-gpiozero python3-lgpio),
#     сам стрим — из .venv (picamera2 и т.д.).
#   - Поднимите паузу: Environment=BOOT_GPIO_STABLE_MS=250 в [Service].

[Unit]
Description=Camera stream (GPIO grounded = run via boot_gpio_gate)
After=multi-user.target network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=pavel
Group=pavel
WorkingDirectory=/home/pavel/projects/Mobile_Raspberry_5-
Environment=CAMSTREAM_BOOT_GPIO_BCM=17
# Не даёт ошибок gpiozero Permission denied после перезагрузки:
SupplementaryGroups=gpio
Environment=BOOT_GPIO_STABLE_MS=400
# После старта сервис до N с ждёт, пока пин замкнут на GND (удобно, если перемычку ставят после включения Pi).
Environment=BOOT_GPIO_WAIT_GROUND_SEC=60
# Имя подключения NetworkManager к домашнему Wi‑Fi (когда приложение не запускается по GPIO):
# Environment=CAMSTREAM_HOME_WIFI_CONN=MyHomeWiFi
# Первый python — boot_gpio_gate (системный lgpio/gpiozero под Pi 5); обёртка — .venv stream_camera.
# Для стабильного operator video после power-up используем udp_h264; IP ПК в hotspot при необходимости замените.
ExecStart=/bin/sh -lc 'exec /home/pavel/projects/Mobile_Raspberry_5-/scripts/camstream-gpio-wifi-fallback.sh send --video-mode udp_h264 --ap-ssid 12345 --ap-force --host 10.42.0.194 --port 5000 --stream-preset realtime'

Restart=no

[Install]
WantedBy=multi-user.target

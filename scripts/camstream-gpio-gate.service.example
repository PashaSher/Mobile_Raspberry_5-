# Пример systemd: стрим камеры только если при загрузке GPIO (BCM) замкнут на GND.
# Скопируйте под своё дерево каталогов, поправьте User/WorkingDirectory/exec start.
#
#   sudo cp scripts/camstream-gpio-gate.service.example /etc/systemd/system/camstream.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable camstream.service
#   sudo systemctl start camstream.service
#
# Схема: переключатель или перемычка между выбранным GPIO (BCM) и GND = запуск;
# если линия в покое подтянута к 3V3 через внутренний pull-up — сервис ничего не запускает.

[Unit]
Description=Camera stream (start only if boot GPIO grounded)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=pavel
Group=pavel
WorkingDirectory=/home/pavel/projects/Mobile_Raspberry_5-
Environment=CAMSTREAM_BOOT_GPIO_BCM=17
ExecStart=/usr/bin/python3 -m rpi_tools.boot_gpio_gate -- \
  /usr/bin/python3 /home/pavel/projects/Mobile_Raspberry_5-/stream_camera.py send --listen --port 5000
Restart=no

[Install]
WantedBy=multi-user.target

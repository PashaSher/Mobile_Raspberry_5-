{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RPI: debug (webrtc + firebase)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/stream_camera.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "-v",
        "webrtc",
        "--firebase-cred",
        "${workspaceFolder}/bro-oppy-firebase-adminsdk-fbsvc-08c5f0ddfe.json",
        "--firebase-db-url",
        "https://bro-oppy-default-rtdb.firebaseio.com",
        "--room",
        "pi-camera"
      ],
      "justMyCode": false,
      "preLaunchTask": "webrtc-debug-prep"
    }
  ]
}

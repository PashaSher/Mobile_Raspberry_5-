{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RPI: send + AP 12345 (по умолчанию, --ap-force)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/stream_camera.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "send",
        "--ap-ssid",
        "12345",
        "--ap-force",
        "--listen",
        "--port",
        "5000",
        "--romeo-turret-step",
        "2"
      ],
      "justMyCode": true,
      "preLaunchTask": "free-camstream-debug-ports"
    },
    {
      "name": "RPI: send + AP 12345 (только при подключённом eth0)",

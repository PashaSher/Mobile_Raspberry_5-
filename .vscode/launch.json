{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RPI: hotspot udp_h264",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/stream_camera.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "send",
        "--video-mode",
        "udp_h264",
        "--ap-ssid",
        "12345",
        "--ap-force",
        "--host",
        "10.42.0.194",
        "--port",
        "5000",
        "--stream-preset",
        "realtime"
      ],
      "justMyCode": true,
      "preLaunchTask": "free-camstream-debug-ports"
    }
  ]
}

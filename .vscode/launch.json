{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RPI: debug (webrtc)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/stream_camera.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/config/webrtc.vps.env",
      "args": [
        "-v",
        "webrtc",
        "--room",
        "pi-camera",
        "--ice-vps-only"
      ],
      "justMyCode": false,
      "preLaunchTask": "webrtc-debug-prep"
    }
  ]
}

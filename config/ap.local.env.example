# Локальные настройки точки доступа Raspberry Pi (не коммитить ap.local.env).
# Создайте файл: cp config/ap.local.env.example config/ap.local.env
#
# Пароль WPA2 — не короче 8 символов (короткий PIN типа 1234 не подойдёт).
# Используется при send --ap-ssid … и wifi-hotspot, если нет --ap-password и RPI_AP_PASSWORD.

AP_PASSWORD=0123456789

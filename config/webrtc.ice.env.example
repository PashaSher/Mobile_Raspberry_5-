# Копия: config/webrtc.ice.local.env (добавьте в .gitignore при локальном использовании)
# или экспортируйте переменные перед запуском webrtc на Pi.
#
# На VPS: ice_config_server + coturn; токен — из /etc/default/ice-config-server (ICE_CONFIG_TOKEN).

ICE_CONFIG_URL=http://116.203.148.254:8788/api/ice
ICE_CONFIG_TOKEN=REPLACE_WITH_SECRET_FROM_SERVER

# Эквивалент CLI:
#   --ice-config-url "$ICE_CONFIG_URL" --ice-config-token "$ICE_CONFIG_TOKEN"
# Без токена в URL сервер всё равно получит Bearer и ?token= (если задан токен).

# Скопируйте в wifi.local.env и заполните (wifi.local.env в git не попадает):
#   cp config/wifi.local.env.example config/wifi.local.env
#   nano config/wifi.local.env
#
# Применить:  python3 stream_camera.py wifi-apply
#         или: ./scripts/wifi_apply.sh

WIFI_SSID=RearWindow

# Один из двух вариантов пароля (не комментируйте оба сразу):
# WIFI_PASSWORD=секрет
WIFI_PASSWORD_FILE=/home/pavel/.wifi_password

# Необязательно:
# WIFI_IFNAME=wlan0
# WIFI_HIDDEN=yes

# Подстройка цвета rpicam без правки Python (source перед send/webrtc).
# cp config/camstream.color.env.example config/camstream.color.env
#
# awbgains: red,blue — меньше жёлтого → ниже red, выше blue (шаг ~0.02–0.04).
# CAMSTREAM_AWB_GAINS=0.8,1.8
# CAMSTREAM_EV=-1
# CAMSTREAM_SATURATION=0.75
#
# Или пресет по TCP/WebRTC Data Channel (не env):
#   {"action":"camera_preset","preset":"cloudy"}
#   {"action":"camera_awb","red":1.14,"blue":1.32}

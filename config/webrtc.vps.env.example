# cp config/webrtc.vps.env.example config/webrtc.vps.env
# Токен — с VPS: sudo …/scripts/show-ice-client-env.sh

WEBRTC_SIGNAL_URL=http://116.203.148.254/api/signal
WEBRTC_ROOM=pi-camera
# 1 = между Connect камера/телеметрия выкл, ждём offer (ping) с VPS
WEBRTC_POWER_SAVE=1
# 1 = браузер → динамик; 0 = только микрофон Pi → браузер
WEBRTC_AUDIO_PLAYBACK=1
# Стабильность на роботе: ниже битрейт/FPS, реже телеметрия (см. scripts/camstream_webrtc.sh)
# CAMSTREAM_VIDEO_BITRATE=1500000
# CAMSTREAM_VIDEO_FPS=20
# CAMSTREAM_TELEMETRY_INTERVAL_SEC=60
# Интервал PUT батареи/Wi‑Fi на VPS (с) — только во время Connect; в idle = 0
CAMSTREAM_TELEMETRY_INTERVAL_SEC=30
ICE_CONFIG_URL=http://116.203.148.254/api/ice
ICE_CONFIG_TOKEN=REPLACE_WITH_TOKEN_FROM_VPS
